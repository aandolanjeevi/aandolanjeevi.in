---
layout: layouts/base.njk
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "/{{ lang }}/index.html"
searchable: true
---
{# Pagefind classic UI, chosen deliberately over the 1.5 Component UI: as of
   1.5.2 neither bundles Hindi/Indic translations, and only the classic UI has
   a documented public `translations` option — so we localize every string
   (visible and assistive) ourselves below. Revisit if the Component UI gains
   Indic translations or a public override API. #}
<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<section id="search-section">
  <h2 class="visually-hidden">{{ "search.heading" | t(lang) }}</h2>
  <div id="search"></div>
</section>
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", function () {
    new PagefindUI({
      element: "#search",
      showSubResults: false,
      showImages: false,
      translations: {
        placeholder: {{ ("search.placeholder" | t(lang)) | dump | safe }},
        clear_search: {{ ("search.clear" | t(lang)) | dump | safe }},
        search_label: {{ ("search.searchLabel" | t(lang)) | dump | safe }},
        filters_label: {{ ("search.filtersLabel" | t(lang)) | dump | safe }},
        zero_results: {{ ("search.zeroResults" | t(lang)) | dump | safe }},
        many_results: {{ ("search.manyResults" | t(lang)) | dump | safe }},
        one_result: {{ ("search.oneResult" | t(lang)) | dump | safe }},
        alt_search: {{ ("search.altSearch" | t(lang)) | dump | safe }},
        search_suggestion: {{ ("search.searchSuggestion" | t(lang)) | dump | safe }},
        searching: {{ ("search.searching" | t(lang)) | dump | safe }},
        load_more: {{ ("search.loadMore" | t(lang)) | dump | safe }}
      }
    });
  });
</script>
<p class="tagline">{{ "tagline" | t(lang) }}</p>

<section id="resources">
  <h1>{{ "nav.resources" | t(lang) }}</h1>
  {%- for cat in site.categories %}
  {%- set catEntries = resources | where("category", cat) %}
  {%- if catEntries.length %}
  <section class="category">
    <h2 id="{{ cat }}">{{ ("categories." + cat) | t(lang) }}</h2>
    <ul class="entries">
      {%- for entry in catEntries %}
      {%- include "resource-entry.njk" %}
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {%- endfor %}
</section>

<section id="posts">
  <h2>{{ "posts.heading" | t(lang) }}</h2>
  <ul class="post-list">
    {%- for post in collections.posts %}
    <li>
      <a href="{{ post.url }}" lang="{{ post.data.lang }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date | readableDate }}">{{ post.date | readableDate }}</time>
    </li>
    {%- endfor %}
  </ul>
</section>
