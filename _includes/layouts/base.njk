<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ "siteTitle" | t(lang) }}</title>
  <meta name="description" content="{{ "tagline" | t(lang) }}">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ "siteTitle" | t(lang) }}">
  <meta property="og:description" content="{{ "tagline" | t(lang) }}">
  <meta property="og:image" content="{{ site.url }}/img/og.png">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ "siteTitle" | t(lang) }}">
</head>
<body>
  <header class="site-header">
    <a class="site-name" href="/{{ lang }}/">
      {%- include "logo.njk" %}
      <span>{{ "siteTitle" | t(lang) }}</span>
    </a>
    <nav>
      <a href="/{{ lang }}/#resources">{{ "nav.resources" | t(lang) }}</a>
      <a href="/{{ lang }}/#posts">{{ "nav.posts" | t(lang) }}</a>
      <a href="/{{ lang }}/submit/">{{ "nav.submit" | t(lang) }}</a>
    </nav>
    <nav class="lang-switch" aria-label="Language">
      {%- for l in site.languages %}
      {%- if l != lang %}
      <a href="/{{ l }}/" lang="{{ l }}">{{ ("langNames." + l) | t(lang) }}</a>
      {%- endif %}
      {%- endfor %}
    </nav>
  </header>
  <main{% if searchable %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </main>
  {%- if site.goatcounter %}
  <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count"
          async src="/js/count.js"></script>
  {%- endif %}
  <footer class="site-footer">
    <p>{{ "footer.license" | t(lang) }} · <a href="{{ site.repo }}">{{ "footer.source" | t(lang) }}</a> · <a href="/index.json">{{ "footer.data" | t(lang) }}</a></p>
  </footer>
</body>
</html>
