# Copy to .env and fill in. .env is gitignored — never commit real values.
# Scripts read these via `node --env-file=.env scripts/<name>.js`.

# Internet Archive S3-like keys (archive.org/account/s3.php).
# Also raises Save Page Now limits for the Wayback pipeline (M7).
IA_ACCESS_KEY=
IA_SECRET_KEY=

# Zenodo personal access token with deposit:write scope (zenodo.org).
ZENODO_TOKEN=
